{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kdb-storefront",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "KDB_DATA_BACKEND": "firestore"
  }
}

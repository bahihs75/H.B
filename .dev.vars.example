# Copy to .dev.vars for local Cloudflare Worker development. Never commit .dev.vars.
# Configure the same values as Cloudflare Worker secrets in production.

KDB_ADMIN_TOKEN=replace-with-a-long-private-owner-token
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_EMAIL=kdb-worker@your-firebase-project-id.iam.gserviceaccount.com
# Preserve the literal \n sequences from the Firebase service-account private key.
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

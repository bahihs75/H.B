{
  "name": "kdb-hb-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test",
    "check:functions": "node --check functions/index.mjs && node --check functions/set-owner-claim.mjs",
    "preview:pages": "wrangler pages dev public",
    "deploy:pages": "wrangler pages deploy public --project-name kdb-storefront"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}

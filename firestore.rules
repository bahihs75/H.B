rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // KDB uses callable Functions for public catalogue snapshots, COD orders,
    // and owner operations. The browser must not receive direct database
    // access; Firebase Admin in Functions bypasses these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
